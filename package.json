{
  "name": "segurolotengo-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:v3": "playwright test --config playwright.v3.config.ts",
    "verify": "npm run typecheck && npm run lint && npm test",
    "piloto:cedulas": "tsx scripts/piloto-cedulas.ts",
    "otp:requerimiento": "tsx scripts/otp-requerimiento.ts",
    "seguridad": "snyk test --severity-threshold=low && snyk iac test infra/ --severity-threshold=high"
  },
  "dependencies": {
    "@aws-amplify/core": "^6.18.0",
    "@aws-amplify/ui-react-liveness": "^3.6.8",
    "@aws-sdk/client-dynamodb": "^3.1115.0",
    "@aws-sdk/client-rekognition": "^3.1115.0",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/client-secrets-manager": "^3.1115.0",
    "@aws-sdk/client-sesv2": "^3.1115.0",
    "@aws-sdk/client-textract": "^3.1115.0",
    "@aws-sdk/lib-dynamodb": "^3.1115.0",
    "aws-amplify": "^6.20.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.26",
    "@smithy/types": "4.17.0"
  }

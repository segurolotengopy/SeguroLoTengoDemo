# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright (e2e)
# `pantallas/` son capturas y PDF generados por e2e/98-capturas-gerencia.spec.ts
# (~15 MB). Se regeneran con `npx playwright test e2e/98-capturas-gerencia.spec.ts`;
# no se versionan para no inflar el repo con binarios derivados.
/pantallas/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# terraform (el .terraform.lock.hcl SÍ se versiona, a propósito)
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/*.tfvars
infra/*.tfplan
infra/crash.log

# Datos reales cedidos para pruebas — nunca al repo
/tests/fixtures/identidad/

# Bytecode de los scripts de Python que arman los PDF de entrega.
__pycache__/
